            {
              "content": "=Pesan pelanggan: {{ $json.message }}\nNama: {{ $json.customer_name }}\nNomor: {{ $json.phone }}\nWaktu pesan: {{ $json.timestamp }} (zona Asia/Jakarta)\nTanggal hari ini: {{ $now.toFormat(\"yyyy-MM-dd\") }}\nRingkasan percakapan sebelumnya: {{ $json.prev_summary || \"(tidak ada - lead baru)\" }}"
            }
