      "parameters": {
        "jsCode": "const ctx = $(\"Ekstrak Pesan\").item.json;\nfunction normalizePhone(p) {\n  let d = String(p || \"\").replace(/\\D/g, \"\");\n  if (d.startsWith(\"0\")) d = \"62\" + d.slice(1);\n  return d;\n}\nlet admin = \"\", shift = \"\";\ntry {\n  const shiftRows = $(\"Baca Shift Admin\").all();\n  for (const s of shiftRows) {\n    const row = s.json || {};\n    const cur = String(row[\"Current_Admin\"] || \"\").trim();\n    if (cur) { admin = cur; shift = String(row[\"Shift\"] || \"\"); break; }\n  }\n} catch (e) { /* sheet belum ada */ }\nconst j = ctx;\nconst hour = Number(new Date(j.timestamp).toLocaleString(\"en-US\", { timeZone: \"Asia/Jakarta\", hour: \"numeric\", hour12: false }));\nconst withinHours = hour >= 9 && hour < 21;\nreturn [{ json: {\n  phone: normalizePhone(j.phone),\n  customer_name: j.customer_name,\n  message: j.message,\n  timestamp: j.timestamp,\n  message_id: j.message_id,\n  active_admin: admin,\n  shift,\n  within_hours: withinHours,\n  status: withinHours ? \"Lead\" : \"Outside Operational Hours\"\n} }];"
      },
