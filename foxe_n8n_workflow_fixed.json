    {
      "parameters": {
        "jsCode": "let base = {};\ntry { base = $(\"Parse Analisis AI\").item.json; } catch (e) {}\nlet strong = null;\ntry {\n  let t = $json.output && $json.output[0] && $json.output[0].content && $json.output[0].content[0] && $json.output[0].content[0].text;\n  if (typeof t === \"string\") {\n    const cleaned = t.replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\n    strong = JSON.parse(cleaned);\n  } else if (typeof t === \"object\" && t !== null) {\n    strong = t;\n  }\n} catch (e) { strong = null; }\nif (!strong || !strong.customer_summary) return [{ json: base }];\nlet score = (typeof strong.score === \"number\") ? strong.score : base.score;\nscore = Math.max(0, Math.min(100, score));\nreturn [{ json: Object.assign({}, base, {\n  ai_summary: strong.customer_summary,\n  intent: strong.intent || base.intent,\n  score,\n  temperature: score <= 30 ? \"Cold\" : (score <= 65 ? \"Warm\" : \"Hot\"),\n  priority: strong.priority || base.priority,\n  priority_reason: strong.priority_reason || base.priority_reason,\n  suggested_action: strong.suggested_action || base.suggested_action,\n  follow_up_date: strong.follow_up_date || base.follow_up_date,\n  follow_up_reason: strong.follow_up_reason || base.follow_up_reason,\n  suggested_reply: strong.suggested_reply || base.suggested_reply,\n  confidence: (typeof strong.confidence === \"number\") ? strong.confidence : base.confidence\n}) }];"
