        "jsCode": "const ctx = $(\"Normalisasi & Konteks\").item.json;\nconst d = new Date(ctx.timestamp);\nconst yy = String(d.getFullYear()).slice(2);\nconst mm = String(d.getMonth() + 1).padStart(2, \"0\");\nconst seq = String(Math.floor(Math.random() * 9000) + 1000);\nconst leadId = \"FL-\" + yy + mm + \"-\" + seq;\nreturn [{ json: {\n  phone: ctx.phone,\n  customer_name: ctx.customer_name,\n  message: ctx.message,\n  timestamp: ctx.timestamp,\n  message_id: ctx.message_id,\n  active_admin: ctx.active_admin,\n  shift: ctx.shift,\n  within_hours: ctx.within_hours,\n  is_new: true,\n  lead_id: leadId,\n  lead_owner: ctx.active_admin,\n  closing_admin: \"\",\n  first_contact: ctx.timestamp,\n  prev_summary: \"\",\n  status: ctx.status,\n  revenue: \"\"\n} }];"
