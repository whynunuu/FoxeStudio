      "parameters": {
        "jsCode": "const lead = $(\"Lead Baru\").item.json;\nconst bk = $json || {};\nconst hasBooking = Object.keys(bk).some(k => k !== \"row_number\" && bk[k] !== \"\" && bk[k] !== undefined && bk[k] !== null);\nlet revenue = \"\";\nfor (const k of Object.keys(bk)) {\n  if (/revenue|total|harga|nilai|amount/i.test(k)) { revenue = bk[k]; break; }\n}\nreturn [{ json: Object.assign({}, lead, {\n  status: hasBooking ? \"Booking\" : lead.status,\n  closing_admin: hasBooking ? lead.active_admin : \"\",\n  revenue: revenue\n}) }];"
      },
