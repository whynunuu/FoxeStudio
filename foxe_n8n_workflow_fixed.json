    {
      "parameters": {
        "jsCode": "const ctx = $(\"Distribusi Data\").item.json;\nlet rawAi = ($json.output && $json.output[0] && $json.output[0].content && $json.output[0].content[0] && $json.output[0].content[0].text) || \"\";\nlet ai = {};\nif (typeof rawAi === \"string\") {\n  try {\n    const cleaned = rawAi.replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\n    ai = JSON.parse(cleaned);\n  } catch (e) { ai = {}; }\n} else if (typeof rawAi === \"object\" && rawAi !== null) {\n  ai = rawAi;\n}\nconst msg = String(ctx.message || \"\");\nlet ruleScore = 0;\nif (/harga|price|biaya|berapa/i.test(msg)) ruleScore += 15;\nif (/paket|package/i.test(msg)) ruleScore += 15;\nif (/tanggal|tgl|date/i.test(msg)) ruleScore += 20;\nif (/slot|tersedia|available|ketersediaan|kosong/i.test(msg)) ruleScore += 20;\nif (/\\b\\d+\\s*(orang|pax|org|tamu)/i.test(msg)) ruleScore += 10;\nif (/\\bdp\\b|down\\s*payment/i.test(msg)) ruleScore += 15;\nif (/rekening|transfer|bank|no.?\\s*rek/i.test(msg)) ruleScore += 20;\nruleScore = Math.min(ruleScore, 100);\nlet score = (typeof ai.score === \"number\") ? ai.score : 0;\nif (ruleScore > 0) score = Math.round(score * 0.6 + ruleScore * 0.4);\nscore = Math.max(0, Math.min(100, score));\nconst temperature = score <= 30 ? \"Cold\" : (score <= 65 ? \"Warm\" : \"Hot\");\nlet priority = ai.priority || \"Low\";\nif (score >= 66 || /tanggal (sudah )?(dipilih|fix)|mau booking|siap dp|jadi transfer/i.test(msg)) priority = \"High\";\nconst conf = (typeof ai.confidence === \"number\") ? ai.confidence : 0.5;\nreturn [{ json: Object.assign({}, ctx, {\n  ai_summary: ai.customer_summary || \"\",\n  intent: ai.intent || \"Lainnya\",\n  score,\n  temperature,\n  priority,\n  priority_reason: ai.priority_reason || \"\",\n  suggested_action: ai.suggested_action || \"\",\n  follow_up_date: ai.follow_up_date || \"\",\n  follow_up_reason: ai.follow_up_reason || \"\",\n  suggested_reply: ai.suggested_reply || \"\",\n  confidence: conf,\n  needs_escalation: conf < 0.6 || msg.length > 800\n}) }];"
      },
