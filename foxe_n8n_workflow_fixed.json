    {
      "parameters": {
        "jsCode": "const items = [];\nfor (const item of $input.all()) {\n  const j = item.json || {};\n  const contacts = j.contacts || [];\n  const messages = j.messages || [];\n  for (const m of messages) {\n    if (!m || !m.from) continue;\n    if (m.type !== \"text\" && !(m.text && m.text.body)) continue;\n    const phone = String(m.from);\n    let name = \"\";\n    for (const c of contacts) { if (String(c.wa_id) === phone && c.profile && c.profile.name) { name = c.profile.name; break; } }\n    if (!name) name = phone;\n    const ts = m.timestamp ? new Date(Number(m.timestamp) * 1000).toISOString() : new Date().toISOString();\n    items.push({ json: { phone, customer_name: name, message: String(m.text.body), timestamp: ts, message_id: m.id || \"\" } });\n  }\n}\nreturn items;"
      },
